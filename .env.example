# Postgres (usado pelo backend e pelo container do banco)
POSTGRES_USER=fintechcrm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fintechcrm
DATABASE_URL=postgresql+psycopg://fintechcrm:change-me@db:5432/fintechcrm

# Autenticação do portal
JWT_SECRET=change-me-too
ADMIN_EMAIL=admin@topfama.com.br
ADMIN_PASSWORD=change-me-admin

# Criptografia de segredos guardados no banco (tokens da Meta e refresh token do Google).
# Chave Fernet (32 bytes em base64 url-safe).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde junto com o backup do banco: sem ela os tokens salvos não abrem.
ENCRYPTION_KEY=ZXhlbXBsb19jaGF2ZV9mZXJuZXRfMzJfYnl0ZXNfX18=

# Meta (WhatsApp Business API)
# Os tokens de acesso da Meta NÃO vão aqui: são cadastrados no portal (Configurações → Tokens da Meta).
# O WABA ID vai junto com o token, e os números (phone_number_id) são importados da WABA em
# Configurações → Números de WhatsApp.
META_GRAPH_API_VERSION=v21.0

# Cache Redis dos relatórios pesados do SETA (Cobrança/Leads/Dashboard) — evita repetir a
# mesma consulta no ERP a cada requisição. Serviço "redis" já vem no docker-compose.
REDIS_URL=redis://redis:6379/0

# Origens liberadas no CORS, separadas por vírgula (ex: https://crm.topfama.com.br).
# "*" (padrão) libera qualquer origem — troque em produção pelo(s) domínio(s) real(is) do frontend.
CORS_ALLOWED_ORIGINS=*

# Domínios aceitos no Host e no Origin; qualquer outro recebe 403. Só preencha para mudar a lista
# padrão (lojastopfama.com.br,*.lojastopfama.com.br,localhost,127.0.0.1,testserver).
# ALLOWED_HOSTS=

# Cookie httpOnly de sessão (ver "Limitações conhecidas / próximos passos" no README). True (padrão) exige https —
# em desenvolvimento local sobre http puro (sem HTTPS), defina como false, senão o navegador
# descarta o cookie e o login não persiste.
COOKIE_SECURE=true

# Frontend
VITE_API_URL=http://localhost:8000

# SETA (ERP) — Postgres externo, usado só para leitura. Vazio = integração desligada.
SETA_DB_HOST=
SETA_DB_PORT=5432
SETA_DB_NAME=seta
SETA_DB_USER=
SETA_DB_PASSWORD=
SETA_DB_CONNECT_TIMEOUT_SECONDS=10
SETA_DB_STATEMENT_TIMEOUT_SECONDS=120
# Consultas pesadas ao SETA ao mesmo tempo (base de cobrança, baixas, situação de títulos); as demais esperam.
SETA_MAX_CONSULTAS_PESADAS=2

# Google (OAuth2) — lê a planilha de lojas (regional, estado, clusters). Vazio = integração desligada.
# Crie um "ID do cliente OAuth" (aplicativo da Web) no Google Cloud, ative a Google Sheets API e
# cadastre GOOGLE_REDIRECT_URI, idêntica, nas URIs de redirecionamento autorizadas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/oauth/callback
GOOGLE_FRONTEND_URL=http://localhost:5173
GOOGLE_SHEET_LOJAS_ID=1QYHjtEjmlJ_4WL_K95TOMV9X63wfF2V5bmK0LGOQ9F0
GOOGLE_SHEET_LOJAS_GID=113434922

# Chatwoot — não tem nada aqui: URL base, ID da conta e token de acesso da API são cadastrados
# em Configurações → Chatwoot (guardados cifrados no banco), e a inbox de cada número em
# Configurações → Números de WhatsApp. Nenhum desses valores vem do ambiente.
# Opcional: CHATWOOT_WEBHOOK_SECRET para validar o cabeçalho X-Chatwoot-Signature
# nas notificações de entrega de mensagem recebidas em /chatwoot/webhook.
CHATWOOT_WEBHOOK_SECRET=

# URL pública deste backend (sem barra final), opcional. Só o envio pelo Chatwoot usa, para o link da
# imagem de cabeçalho do template (pela Meta a imagem vai como media_id); não funciona com localhost.
# Vazio = vale o endereço por onde a imagem foi subida.
PUBLIC_BASE_URL=

# Onde cada container publica a porta no host. O padrão (127.0.0.1) nunca expõe
# nada para a internet. Atrás de proxy reverso, aponte para a porta que o proxy
# chama — na VPS: BACKEND_BIND=127.0.0.1:18001 e FRONTEND_BIND=127.0.0.1:13001.
DB_BIND=127.0.0.1:5432
BACKEND_BIND=127.0.0.1:8000
FRONTEND_BIND=127.0.0.1:5173
